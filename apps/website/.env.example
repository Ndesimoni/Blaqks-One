# Explicit sample mode works only on known *.localhost hosts. Never a fallback.
WEBSITE_DATA_MODE=sample
# For the live public API use WEBSITE_DATA_MODE=api and set this server-only origin.
# WEBSITE_API_ORIGIN=https://api.example.com
# Absolute URL of the deployed CRM app (HTTPS, or HTTP on loopback for development).
# WEBSITE_CRM_URL=https://crm.example.com
