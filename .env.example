# Local Docker PostgreSQL. Generate private values with npm run setup:crm.
CRM_POSTGRES_PASSWORD=replace-with-a-random-local-password
CRM_POSTGRES_PORT=55432
CRM_DATABASE_URL=postgres://kws_crm:replace-with-a-random-local-password@127.0.0.1:55432/kws_crm
CRM_APP_ORIGIN=http://localhost:5173
CRM_BIND_ADDRESS=127.0.0.1:8788
# Development only; the API requires Secure cookies outside loopback HTTP.
CRM_ALLOW_INSECURE_LOCAL=true
# Local-only sign-up API. Keep off unless using the marked development database.
CRM_SIGNUP=off
# The existing browser-local demo remains the default.
VITE_CRM_MODE=server
CRM_API_PROXY=http://127.0.0.1:8788
# Offer Arabic (right to left) in My profile. Most screens are still English until the
# translation pass, so keep this off for real users (docs/i18n.md).
VITE_I18N_PREVIEW=false
