# Local Docker PostgreSQL. Generate private values with npm run setup:crm.
CRM_POSTGRES_PASSWORD=replace-with-a-random-local-password
CRM_POSTGRES_PORT=55432
CRM_DATABASE_URL=postgres://kws_crm:replace-with-a-random-local-password@127.0.0.1:55432/kws_crm
CRM_APP_ORIGIN=http://localhost:5173
CRM_BIND_ADDRESS=127.0.0.1:8788
# Development only; the API requires Secure cookies outside loopback HTTP.
CRM_ALLOW_INSECURE_LOCAL=true
# Local-only sign-up API. Keep off unless using the marked development database.
CRM_SIGNUP=off
# Local delivery worker: on keeps retries flowing; off lets tests inspect pending codes.
CRM_SIGNUP_WORKER=on
# Per-caller sign-up budgets key on a keyed digest of the client address, never the raw
# address. Set the proxies allowed to supply the client header and rotate the secret.
CRM_TRUSTED_PROXIES=
CRM_TRUSTED_CLIENT_HEADER=cf-connecting-ip
CRM_CLIENT_DIGEST_SECRET=replace-with-a-random-local-secret
# Seals channel credentials (AES-256-GCM). Required outside local development; locally,
# leaving it unset disables Channels. Generate with: openssl rand -base64 32
# CRM_MESSAGING_KEY=
# CRM_MESSAGING_KEY_VERSION=1
# Private file storage (docs/media-storage.md): the Docker storage service locally, a
# UAE-region S3 bucket in production (https only). Generate keys with npm run setup:crm.
# CRM_MEDIA_ENDPOINT=http://127.0.0.1:58333
# CRM_MEDIA_BUCKET=crm-media
# CRM_MEDIA_ACCESS_KEY=
# CRM_MEDIA_SECRET_KEY=
# Google Workspace mailboxes (docs/google-mail-setup.md). Both values or neither; the
# domain limits connections to the company's own addresses.
# CRM_GOOGLE_CLIENT_ID=
# CRM_GOOGLE_CLIENT_SECRET=
# CRM_GOOGLE_WORKSPACE_DOMAIN=
# Turnstile replaces the local bypass whenever all three values are present, including in
# CRM_SIGNUP=local. Outside local development the digest secret (32+ characters) is required.
CRM_TURNSTILE_SECRET=
CRM_TURNSTILE_SITE_KEY=
CRM_TURNSTILE_HOSTNAME=
# The existing browser-local demo remains the default.
VITE_CRM_MODE=server
CRM_API_PROXY=http://127.0.0.1:8788
# Offer Arabic (right to left) in My profile. Most screens are still English until the
# translation pass, so keep this off for real users (docs/i18n.md).
VITE_I18N_PREVIEW=false
