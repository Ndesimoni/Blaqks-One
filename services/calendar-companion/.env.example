# Copy to services/calendar-companion/.env. Do not place these values in a VITE_ variable.
APP_ORIGIN=http://localhost:5173
CALENDAR_PORT=8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=
# Encrypted Google credentials, event links and pending work. Keep this file and key.
CALENDAR_STORE=./data/calendar.enc
# Register APP_ORIGIN + /api/calendar/oauth/callback as an authorized redirect URI.
