{
  "name": "keys-with-simoni-real-estate-crm",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/crm"
  ],
  "description": "Blaqks One: CRM frontend (apps/crm), websites (apps/website), CRM API (services/crm-api)",
  "scripts": {
    "dev": "npm run dev -w apps/crm --",
    "setup:crm": "node scripts/setup-crm.mjs",
    "db:up": "docker compose up -d --wait postgres storage",
    "db:migrate": "cargo run --locked --manifest-path services/crm-api/Cargo.toml -- migrate",
    "db:stop": "docker compose stop postgres",
    "db:mark-dev": "node scripts/mark-dev-database.mjs",
    "dev:api": "cargo run --locked --manifest-path services/crm-api/Cargo.toml",
    "dev:google": "node scripts/dev-fake-google.mjs",
    "dev:sendgrid": "node scripts/dev-fake-sendgrid.mjs",
    "dev:twilio": "node scripts/dev-fake-twilio.mjs",
    "dev:worker": "cargo run --locked --manifest-path services/crm-api/Cargo.toml --bin messaging_worker",
    "crm:create-user": "node scripts/create-crm-user.mjs",
    "crm:sample-data": "node scripts/crm-sample-data.mjs seed",
    "crm:clear-sample": "node scripts/crm-sample-data.mjs clear",
    "demo:backup": "node scripts/create-demo-backup.mjs",
    "test:api": "node scripts/test-crm-api.mjs",
    "test:server:e2e": "node scripts/test-crm-api.mjs --browser",
    "dev:calendar": "cd services/calendar-companion && cargo run --locked",
    "test:calendar": "cargo test --locked --manifest-path services/calendar-companion/Cargo.toml",
    "build": "npm run build -w apps/crm --",
    "preview": "npm run preview -w apps/crm --",
    "offline": "python3 -m http.server 4173 --directory legacy/offline/public",
    "build:offline": "node scripts/build-offline.cjs",
    "test": "npm run test -w apps/crm --",
    "test:unit": "npm run test:unit -w apps/crm --",
    "test:offline": "npm run test:offline -w apps/crm --",
    "test:e2e": "npm run test:e2e -w apps/crm --",
    "check:lines": "node scripts/check-file-size.mjs",
    "check:lines:ci": "node scripts/check-file-size.mjs --baseline scripts/file-size-baseline.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
